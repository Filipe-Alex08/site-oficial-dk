NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_YOUTUBE_URL=
APIFY_TOKEN=
APIFY_INSTAGRAM_USERNAME=dkbhmg
# Opcional: substitua se usar outro ator compatível com apify/instagram-scraper
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-scraper
# Opcional: segredo para um agendador externo chamar a rota GET de sincronização
CRON_SECRET=
# Opcional: redireciona HTTP para HTTPS na aplicação. Só ligue depois de
# confirmar que o proxy à frente envia X-Forwarded-Proto com o protocolo
# original — sem isso o redirecionamento entra em laço. No Cloudflare, prefira
# a opção "Always Use HTTPS". Exige NEXT_PUBLIC_SITE_URL começando com https://.
FORCE_HTTPS=0
# Opcional: conexão do servidor com o Postgres para o tempo real (LISTEN). Sem ela o
# site funciona normalmente, só sem atualização ao vivo (/api/realtime responde 503).
# No servidor de produção use a porta 5432 do Supavisor (modo sessão, aceita LISTEN),
# nunca a 6543. O deploy/realtime-db.ps1 -Apply cria um papel só para escutar avisos
# (dk_realtime, sem acesso a nenhuma tabela) e grava esta linha sem mostrar a senha.
# Formato: postgresql://dk_realtime.<tenant>:<senha>@127.0.0.1:5432/postgres
REALTIME_DATABASE_URL=
# Opcional: avisos de cadastro recebido e aprovado, enviados pelo site. São os mesmos
# valores do SMTP do Supabase (Brevo > SMTP & API). Sem eles o site funciona, só não
# envia esses avisos. Veja docs/EMAILS.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Death Knights
