NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_YOUTUBE_URL=
APIFY_TOKEN=
APIFY_INSTAGRAM_USERNAME=dkbhmg
# Opcional: substitua se usar outro ator compatível com apify/instagram-scraper
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-scraper
# Opcional: segredo para um agendador externo chamar a rota GET de sincronização
CRON_SECRET=
# Opcional: redireciona HTTP para HTTPS na aplicação. Só ligue depois de
# confirmar que o proxy à frente envia X-Forwarded-Proto com o protocolo
# original — sem isso o redirecionamento entra em laço. No Cloudflare, prefira
# a opção "Always Use HTTPS". Exige NEXT_PUBLIC_SITE_URL começando com https://.
FORCE_HTTPS=0
